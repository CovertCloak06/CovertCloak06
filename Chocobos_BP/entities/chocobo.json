{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "cb:chocobo",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "cb:can_fly": { "type": "bool", "default": false, "client_sync": true }
      }
    },

    "component_groups": {
      "cb:adult": {
        "minecraft:scale": { "value": 1.0 },
        "minecraft:collision_box": { "width": 0.9, "height": 1.9 },
        "minecraft:behavior.breed": { "priority": 3, "speed_multiplier": 1.0 },
        "minecraft:breedable": {
          "require_tame": true,
          "require_full_health": false,
          "inherit_tamed": false,
          "breed_items": ["cb:gysahl_green"],
          "breeds_with": [
            {
              "mate_type": "cb:chocobo",
              "baby_type": "cb:chocobo",
              "breed_event": { "event": "minecraft:entity_born", "target": "baby" }
            }
          ]
        }
      },

      "cb:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": { "value": 0.45 },
        "minecraft:collision_box": { "width": 0.5, "height": 0.9 },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": ["wheat"],
          "grow_up": { "event": "cb:grow_up", "target": "self" }
        },
        "minecraft:behavior.follow_parent": { "priority": 5, "speed_multiplier": 1.1 }
      },

      "cb:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:persistent": {},
        "minecraft:rideable": {
          "seat_count": 1,
          "crouching_skip_interact": true,
          "family_types": ["player"],
          "interact_text": "action.interact.ride.chocobo",
          "pull_in_entities": false,
          "seats": [{ "position": [0.0, 1.05, -0.2], "lock_rider_rotation": 181 }]
        },
        "minecraft:input_ground_controlled": {},
        "minecraft:can_power_jump": {},
        "minecraft:behavior.player_ride_tamed": { "priority": 0 },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
                "filters": {
                  "all_of": [
                    { "test": "is_family", "subject": "other", "value": "player" },
                    { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "saddle" },
                    { "test": "is_tamed", "subject": "self", "value": true },
                    { "test": "has_component", "subject": "self", "operator": "!=", "value": "minecraft:is_saddled" }
                  ]
                },
                "event": "cb:on_saddle",
                "target": "self"
              },
              "use_item": true,
              "play_sounds": "saddle",
              "interact_text": "action.interact.saddle"
            }
          ]
        }
      },

      "cb:saddled": {
        "minecraft:is_saddled": {}
      },

      "cb:variant_yellow": {
        "minecraft:variant": { "value": 0 },
        "minecraft:movement": { "value": 0.22 },
        "minecraft:horse.jump_strength": { "value": 0.6 }
      },
      "cb:variant_black": {
        "minecraft:variant": { "value": 1 },
        "minecraft:movement": { "value": 0.30 },
        "minecraft:horse.jump_strength": { "value": 0.9 }
      },
      "cb:variant_red": {
        "minecraft:variant": { "value": 2 },
        "minecraft:movement": { "value": 0.24 },
        "minecraft:horse.jump_strength": { "value": 0.65 },
        "minecraft:fire_immune": {}
      },
      "cb:variant_blue": {
        "minecraft:variant": { "value": 3 },
        "minecraft:movement": { "value": 0.24 },
        "minecraft:horse.jump_strength": { "value": 0.6 },
        "minecraft:navigation.walk": {
          "can_path_over_water": true,
          "avoid_water": false,
          "can_swim": true,
          "can_walk": true,
          "can_sink": false
        }
      },
      "cb:variant_green": {
        "minecraft:variant": { "value": 4 },
        "minecraft:movement": { "value": 0.26 },
        "minecraft:horse.jump_strength": { "value": 0.8 }
      },
      "cb:variant_gold": {
        "minecraft:variant": { "value": 5 },
        "minecraft:movement": { "value": 0.34 },
        "minecraft:horse.jump_strength": { "value": 1.0 },
        "minecraft:fire_immune": {},
        "minecraft:navigation.walk": {
          "can_path_over_water": true,
          "avoid_water": false,
          "can_swim": true,
          "can_walk": true,
          "can_sink": false
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["chocobo", "mob"] },
      "minecraft:health": { "value": 24, "max": 24 },
      "minecraft:knockback_resistance": { "value": 0.0 },
      "minecraft:movement": { "value": 0.22 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:collision_box": { "width": 0.9, "height": 1.9 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:despawn": {
        "despawn_from_distance": {},
        "filters": {
          "all_of": [
            { "test": "is_tamed", "subject": "self", "value": false },
            { "test": "is_leashed", "subject": "self", "value": false }
          ]
        }
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false
      },
      "minecraft:nameable": {},
      "minecraft:loot": { "table": "loot_tables/entities/chocobo.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? math.random_integer(1, 3) : 0" },
      "minecraft:leashable": { "soft_distance": 4.0, "hard_distance": 6.0, "max_distance": 10.0 },
      "minecraft:balloonable": { "mass": 1.0 },
      "minecraft:horse.jump_strength": { "value": 0.6 },

      "minecraft:tameable": {
        "probability": 0.35,
        "tame_items": ["cb:gysahl_green"],
        "tame_event": { "event": "cb:on_tame", "target": "self" }
      },

      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.panic": { "priority": 1, "speed_multiplier": 1.5 },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.2,
        "can_tame": true,
        "items": ["cb:gysahl_green", "wheat"]
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 8.0, "probability": 0.02 },
      "minecraft:behavior.random_look_around": { "priority": 8 },

      "minecraft:conditional_bandwidth_optimization": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          { "add": { "component_groups": ["cb:adult"] } },
          {
            "randomize": [
              { "weight": 50, "add": { "component_groups": ["cb:variant_yellow"] } },
              { "weight": 15, "add": { "component_groups": ["cb:variant_green"] } },
              { "weight": 12, "add": { "component_groups": ["cb:variant_blue"] } },
              { "weight": 10, "add": { "component_groups": ["cb:variant_red"] } },
              { "weight": 8,  "add": { "component_groups": ["cb:variant_black"] }, "set_property": { "cb:can_fly": true } },
              { "weight": 5,  "add": { "component_groups": ["cb:variant_gold"] }, "set_property": { "cb:can_fly": true } }
            ]
          }
        ]
      },

      "minecraft:entity_born": {
        "sequence": [
          { "add": { "component_groups": ["cb:baby"] } },
          {
            "randomize": [
              { "weight": 45, "add": { "component_groups": ["cb:variant_yellow"] } },
              { "weight": 15, "add": { "component_groups": ["cb:variant_green"] } },
              { "weight": 13, "add": { "component_groups": ["cb:variant_blue"] } },
              { "weight": 11, "add": { "component_groups": ["cb:variant_red"] } },
              { "weight": 9,  "add": { "component_groups": ["cb:variant_black"] }, "set_property": { "cb:can_fly": true } },
              { "weight": 7,  "add": { "component_groups": ["cb:variant_gold"] }, "set_property": { "cb:can_fly": true } }
            ]
          }
        ]
      },

      "cb:grow_up": {
        "remove": { "component_groups": ["cb:baby"] },
        "add": { "component_groups": ["cb:adult"] }
      },

      "cb:on_tame": {
        "add": { "component_groups": ["cb:tamed"] }
      },

      "cb:on_saddle": {
        "add": { "component_groups": ["cb:saddled"] }
      }
    }
  }
}
