{
  "format_version": "1.8.0",
  "animations": {
    "animation.chocobo.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [0, "math.sin(query.anim_time * 90) * 0.5", 0]
        },
        "head": {
          "rotation": ["math.sin(query.anim_time * 60) * 2.0", 0, 0]
        },
        "crest": {
          "rotation": [0, 0, "math.sin(query.anim_time * 70) * 5.0"]
        },
        "tail": {
          "rotation": ["math.sin(query.anim_time * 80) * 3.0", 0, 0]
        }
      }
    },

    "animation.chocobo.walk": {
      "loop": true,
      "anim_time_update": "query.anim_time + query.delta_time * query.modified_move_speed * 2.0",
      "bones": {
        "leg_left": {
          "rotation": ["math.cos(query.anim_time * 360 * 1.4) * 45", 0, 0]
        },
        "leg_right": {
          "rotation": ["math.cos(query.anim_time * 360 * 1.4 + 180.0) * 45", 0, 0]
        },
        "foot_left": {
          "rotation": ["-math.cos(query.anim_time * 360 * 1.4) * 18", 0, 0]
        },
        "foot_right": {
          "rotation": ["-math.cos(query.anim_time * 360 * 1.4 + 180.0) * 18", 0, 0]
        },
        "body": {
          "position": [0, "math.abs(math.cos(query.anim_time * 360 * 1.4)) * 1.2", 0],
          "rotation": ["math.cos(query.anim_time * 360 * 1.4) * 2.0", 0, 0]
        },
        "wing_left": {
          "rotation": [0, 0, "6.0 + math.cos(query.anim_time * 360 * 1.4) * 10"]
        },
        "wing_right": {
          "rotation": [0, 0, "-6.0 - math.cos(query.anim_time * 360 * 1.4) * 10"]
        },
        "tail": {
          "rotation": ["math.cos(query.anim_time * 360 * 1.4) * 5.0", 0, 0]
        }
      }
    },

    "animation.chocobo.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0]
        }
      }
    }
  }
}
