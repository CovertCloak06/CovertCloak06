{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.chocobo": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.yellow",
            "Texture.black",
            "Texture.red",
            "Texture.blue",
            "Texture.green",
            "Texture.gold"
          ],
          "Array.baby_skins": [
            "Texture.baby_yellow",
            "Texture.baby_black",
            "Texture.baby_red",
            "Texture.baby_blue",
            "Texture.baby_green",
            "Texture.baby_gold"
          ]
        },
        "geometries": {
          "Array.models": [
            "Geometry.chocobo",
            "Geometry.chickabo"
          ]
        }
      },
      "geometry": "query.is_baby ? Array.models[1] : Array.models[0]",
      "materials": [ { "*": "Material.default" } ],
      "textures": [
        "query.is_baby ? Array.baby_skins[query.variant] : Array.skins[query.variant]"
      ]
    }
  }
}
