# --- Site ---------------------------------------------------------------
# Canonical public URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Secure-intake upload ceiling in MB (default 100). Lower it on hosts whose
# function body limit is smaller (e.g. Netlify's 6 MB synchronous payload).
NEXT_PUBLIC_MAX_UPLOAD_MB=

# --- Supabase -----------------------------------------------------------
# Project URL and anon key are safe for the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Never expose to the browser or client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse prevention (Cloudflare Turnstile) ----------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error monitoring (Sentry) ------------------------------------------
SENTRY_DSN=

# --- Privacy-conscious analytics (Umami or Plausible) -------------------
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Transactional email (Resend) ---------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
