{
  "name": "@watch-party/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop browser extension (Manifest V3) that syncs streaming-site playback with a watch party room.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --dev && playwright test"
  },
  "dependencies": {
    "@watch-party/shared": "0.1.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
