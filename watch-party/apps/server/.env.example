# Copy to .env (git-ignored) or export in your shell / hosting dashboard.

# --- Required in production ---------------------------------------------------
# HMAC secret for session tokens, 32+ characters: openssl rand -hex 32
SESSION_SECRET=
# Redis for catalog cache, room state and multi-instance broadcasts.
# Unset = in-memory store (single instance, state lost on restart).
REDIS_URL=redis://localhost:6379

# --- Catalog data (pick one; "auto" prefers Streaming Availability) -----------
CATALOG_PROVIDER=auto
# Streaming Availability API (RapidAPI key, or direct key with MODE=direct)
STREAMING_AVAILABILITY_API_KEY=
STREAMING_AVAILABILITY_MODE=rapidapi
# TMDB v4 read access token (also used for posters/runtime enrichment)
TMDB_READ_TOKEN=
# TMDB_API_KEY=            # v3 key alternative
# Regional catalog cache lifetime (spec: 12-24h) and page budget per catalog
CATALOG_TTL_HOURS=18
CATALOG_MAX_PAGES=25
# Demo deployments only: allow the fake built-in catalog in production
ALLOW_FIXTURE_CATALOG=0

# --- Server --------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 behind a reverse proxy / load balancer so client IPs are correct
TRUST_PROXY=0
# Comma-separated browser origins, or * (tokens are bearer, never cookies)
CORS_ORIGINS=*
# How long a disconnected member keeps their seat and host role (ms)
MEMBER_GRACE_MS=20000
# Browser test harness at /dev (defaults to on outside production)
# DEV_HARNESS=1
